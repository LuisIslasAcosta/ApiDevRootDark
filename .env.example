# Copia este archivo como .env y llena los valores reales.
# NUNCA subas el .env a GitHub.

# MongoDB Atlas
MONGO_USER=
MONGO_PASSWORD=
MONGO_HOST=tucluster.xxxxx.mongodb.net
MONGO_APPNAME=DevRootDark
MONGO_DB=DevRootDark

# Clave para firmar los tokens JWT (larga y aleatoria)
# Genérala con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Dominios que pueden consumir la API, separados por coma
CORS_ORIGINS=https://tu-sitio.netlify.app,http://localhost:5173

# Tamaño máximo de archivos subidos (MB)
MAX_UPLOAD_MB=200

# Solo para desarrollo local con "python app.py"
FLASK_DEBUG=1

# Correo de confirmación de cuenta (Gmail con contraseña de aplicación)
# Crea la contraseña en https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=tucorreo@gmail.com
MAIL_PASSWORD=
MAIL_FROM_NAME=DevRootDark

# Dirección de tu página (para el enlace del correo)
FRONTEND_URL=https://tu-sitio.netlify.app

# Iniciar sesión con Google (ID de cliente OAuth de Google Cloud)
GOOGLE_CLIENT_ID=123456789-xxxxxxxx.apps.googleusercontent.com

# Versión vigente de los términos y condiciones (fecha). Al cambiarla, todos los usuarios
# deben aceptarlos de nuevo al entrar. Debe coincidir con la fecha que muestra /politicas en el frontend.
TERMINOS_VERSION=2026-11-12
